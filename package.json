{
  "name": "pico-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx --import ./scripts/env.ts server.ts",
    "build": "next build",
    "build:release": "next build && npx dotenv-cli -e .env.local -- node dist/server.js",
    "build:server": "tsup server.ts --format esm --out-dir dist  --tsconfig tsconfig.server.json",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "gmail:authorize": "tsx scripts/authorize-gmail.ts",
    "gmail:watch": "tsx scripts/start-watch.ts",
    "generate-token": "tsx scripts/generate-token.ts",
    "test-connection": "tsx scripts/test-connection.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "form-data": "^4.0.5",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "motion": "^12.38.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.31",
    "node-fetch": "^3.3.2",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redis": "^5.11.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "usehooks-ts": "^3.1.1",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
