#define ENV_AUTH_TOKEN "your.auth.token"
#define ENV_SERVER_HOST "your.server.com"
#define ENV_SAMPLE_RATE 32000
#define USE_MIC           true 
#define BUTTON_PIN        4
#define LED_PIN           3
#define VOLUME_PIN        5
#define USE_VOLUME_PIN    false
#define FORCE_WIFI_ONBOARDING false

#define WORD_SELECT_PIN  44
#define BIT_CLOCK_PIN    43

// Mic (INMP441) — I2S_NUM_1
#define I2S_MIC_SCK       BIT_CLOCK_PIN   
#define I2S_MIC_WS        WORD_SELECT_PIN   
#define I2S_MIC_SD        1   // data in

// Speaker (MAX98357 or similar) — I2S_NUM_0
// Mic and speaker share BCLK/WS as before
#define I2S_PLAY_SCK      BIT_CLOCK_PIN
#define I2S_PLAY_WS       WORD_SELECT_PIN
#define I2S_PLAY_DOUT     2   // data out
#define DEVICE_ID         "your-device-id"